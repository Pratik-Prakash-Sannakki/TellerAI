# Direct Anthropic is the default: every LLM call uses this key (src/cua/llm.py).
ANTHROPIC_API_KEY=
MODEL=anthropic:claude-sonnet-5
PARABANK_USERNAME=
PARABANK_PASSWORD=

# Optional model-name overrides; blank = the built-in defaults.
ILIAD_SONNET_MODEL=
ILIAD_HAIKU_MODEL=

# Optional LLM gateway (opt-in). Only when ILIAD_BASE_URL is set do calls go through it,
# using ILIAD_API_KEY. Leave both commented out for direct Anthropic.
# ILIAD_BASE_URL=https://your-gateway.example/anthropic
# ILIAD_API_KEY=
# Optional: corporate CA bundle path, if the gateway's TLS cert is not trusted by default.
# SSL_CERT_FILE=
