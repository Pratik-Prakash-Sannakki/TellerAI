# Every LLM call goes direct to Anthropic with this key (src/cua/llm.py).
# The key needs access to two models: Sonnet (every agent step by default) and Haiku (routed
# steps when TYPESAFE_API_KEY is set, and the NeMo goal check when rails are on).
# Model names are not set here: see SONNET_MODEL_NAME / HAIKU_MODEL_NAME in src/cua/config.py.
ANTHROPIC_API_KEY=
PARABANK_USERNAME=
PARABANK_PASSWORD=

# Optional: corporate CA bundle path, if your network's TLS cert is not trusted by default.
# SSL_CERT_FILE=

# Optional: turns on TypeSafe tool + per-step Haiku/Sonnet routing for discovery.
# TYPESAFE_API_KEY=

# Optional: LangSmith tracing for discovery (agent trace, latency, token usage and cost per run).
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
