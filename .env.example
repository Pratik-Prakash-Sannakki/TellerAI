ANTHROPIC_API_KEY=
MODEL=anthropic:claude-sonnet-5
PARABANK_USERNAME=
PARABANK_PASSWORD=

# Optional (D50): routes each agent step to Haiku or Sonnet via TypeSafe.
# Leave blank to skip it; the agent then just uses MODEL for everything.
# Get a key at https://typesafe.ai — a third party, not Anthropic.
TYPESAFE_API_KEY=

# Company Iliad gateway: every LLM call goes through it (src/cua/models.py).
# If ILIAD_API_KEY is blank but ANTHROPIC_API_KEY is set, calls fall back to Anthropic's own API.
# The three below are optional overrides; blank = the built-in defaults.
ILIAD_API_KEY=
ILIAD_BASE_URL=
ILIAD_SONNET_MODEL=
ILIAD_HAIKU_MODEL=
# Optional: corporate CA bundle path, if the gateway's TLS cert is not trusted by default.
SSL_CERT_FILE=
